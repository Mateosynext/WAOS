{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivacyNoticeEvidence",
  "type": "object",
  "required": [
    "subject_id",
    "notice_version",
    "event_type",
    "recorded_at"
  ],
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "notice_version": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "displayed",
        "accepted",
        "linked",
        "revoked"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "evidence_hash": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
