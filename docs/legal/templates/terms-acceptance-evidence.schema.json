{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TermsAcceptanceEvidence",
  "type": "object",
  "required": [
    "organization_id",
    "user_id",
    "terms_version",
    "accepted_at"
  ],
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "terms_version": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "evidence_hash": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "ip": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  }
}
