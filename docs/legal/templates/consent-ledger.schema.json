{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsentLedgerEvent",
  "type": "object",
  "required": [
    "contact_id",
    "organization_id",
    "consent_type",
    "purpose",
    "channel",
    "status",
    "legal_text_version",
    "captured_at"
  ],
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "privacy_notice",
        "terms",
        "marketing",
        "whatsapp_opt_in",
        "sensitive_data",
        "image",
        "cookies",
        "other"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "denied",
        "revoked",
        "updated"
      ]
    },
    "legal_text_version": {
      "type": "string"
    },
    "evidence_uri": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_by": {
      "type": "string"
    },
    "ip": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
