# WAOS frontend production env - canonical source of truth.
# This is the only canonical frontend env example.
# Use these values in Vercel. Do not deploy the frontend on Render.

NEXT_PUBLIC_APP_URL=https://your-frontend.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://your-waos-api.onrender.com

API_INTERNAL_URL=https://your-waos-api.onrender.com
API_BASE_URL=https://your-waos-api.onrender.com

API_TIMEOUT_MS=30000
API_RETRIES=2

SECURE_COOKIES=true
WAOS_ALLOW_ENV_FALLBACK=false

NEXT_PUBLIC_SENTRY_DSN=
