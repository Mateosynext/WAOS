        "status"
      ]
    },
    {
      "template_key": "warranty_followup",
      "title": "Seguimiento garantia",
      "content": "Te escribimos para confirmar que todo quedo bien y ayudarte con cualquier garantia o ajuste.",
      "variables": []
    }
  ],
