{
  "name": "waos-web",
  "private": true,
  "version": "0.17.5",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node ./scripts/validate-env.mjs && node ./scripts/clean-stale-botstudio.mjs && npm run check:imports && npm run check:bot-creation && npm run typecheck && next build",
    "vercel-build": "npm run build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "node ./scripts/clean-stale-botstudio.mjs && npm run check:imports && tsc --noEmit",
    "smoke": "node --no-warnings --import tsx ./scripts/smoke-routes.mjs",
    "test": "npm run test:node",
    "test:critical": "npm run smoke && npm run test:node && npm run test:e2e:real:critical",
    "e2e": "npm run test:e2e:real",
    "test:all": "npm run smoke && npm run typecheck && npm run test:node && npm run test:e2e:real",
    "test:node": "node --no-warnings --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:e2e:real:critical": "playwright test --config=playwright.real.config.ts --grep @critical",
    "validate:delivery": "node ./scripts/validate-static-delivery.mjs",
    "clean": "rm -rf .next node_modules tsconfig.tsbuildinfo playwright-report test-results coverage",
    "clean:stale": "node ./scripts/clean-stale-botstudio.mjs",
    "start:render": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "check:imports": "node ./scripts/check-local-imports.mjs",
    "check:bot-creation": "node ./scripts/check-bot-creation-guardrails.mjs && npm run check:p1-operational",
    "check:p1-operational": "node ./scripts/check-p1-operational-guardrails.mjs && npm run check:critical-flows",
    "check:critical-flows": "node ./scripts/check-critical-flow-guardrails.mjs && npm run check:multi-tenant-security",
    "check:multi-tenant-security": "node ./scripts/check-multitenant-security-guardrails.mjs && npm run check:workflow-runtime",
    "check:workflow-runtime": "node ./scripts/check-workflow-runtime-guardrails.mjs"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "next": "15.5.15",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
