{
  "name": "waos-web",
  "private": true,
  "version": "0.17.5",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node ./scripts/validate-env.mjs && npm run typecheck && next build --no-lint",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "node ./scripts/smoke-routes.mjs",
    "test": "npm run test:node",
    "test:critical": "npm run smoke && npm run test:node && npm run test:e2e:real:critical",
    "e2e": "npm run test:e2e:real",
    "test:all": "npm run smoke && npm run typecheck && npm run test:node && npm run test:e2e:real",
    "test:node": "node --no-warnings --experimental-default-type=module --test --experimental-strip-types tests/**/*.test.ts",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:e2e:real:critical": "playwright test --config=playwright.real.config.ts --grep @critical",
    "validate:delivery": "node ./scripts/validate-static-delivery.mjs",
    "clean": "rm -rf .next node_modules tsconfig.tsbuildinfo playwright-report test-results coverage"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "@playwright/test": "^1.59.1"
  }
}
