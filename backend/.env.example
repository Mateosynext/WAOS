APP_NAME=WAOS
APP_ENV=production
APP_VERSION=0.17.5
APP_SECRET=
SECRET_ENCRYPTION_KEY=
DATABASE_URL=postgresql://user:password@host:5432/waos
PUBLIC_APP_URL=https://app.example.com
API_BASE_URL=https://api.example.com
API_INTERNAL_URL=http://backend:8000
CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com
ALLOWED_HOSTS=api.example.com
SECURE_COOKIES=true
TRUST_PROXY_HEADERS=false
RUN_BOOTSTRAP_SEED=false
AUTO_RUN_MIGRATIONS=true
DEFAULT_TIMEZONE=America/Mexico_City
LOG_LEVEL=INFO
SENTRY_DSN=
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3-flash-preview
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
META_VERIFY_TOKEN=
META_GRAPH_API_BASE=https://graph.facebook.com/v23.0
DB_POOL_MIN_SIZE=4
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=15
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=30
RUNTIME_CACHE_TTL_SECONDS=10
GZIP_MINIMUM_SIZE=1024
WEB_CONCURRENCY=2
WORKER_BATCH_SIZE=50
WORKER_POLL_SECONDS=5
WORKER_MIN_POLL_SECONDS=1
WORKER_MAX_POLL_SECONDS=15
WORKER_BACKPRESSURE_BATCH_CEILING=200
WORKER_RETRY_BUDGET_WINDOW_SECONDS=900
INBOUND_SPAM_WINDOW_SECONDS=60
INBOUND_SPAM_MAX_EVENTS=12
PUBLIC_INGEST_WINDOW_SECONDS=60
PUBLIC_INGEST_MAX_EVENTS=5
OPENAI_CIRCUIT_FAILURE_THRESHOLD=3
OPENAI_CIRCUIT_OPEN_MINUTES=2
META_CIRCUIT_FAILURE_THRESHOLD=3
META_CIRCUIT_OPEN_MINUTES=2

WAOS_E2E_FAKE_PROVIDERS=false

VOICE_MEDIA_STORAGE_DIR=./.waos-voice-media
VOICE_MEDIA_TTL_MINUTES=1440
VOICE_TRANSCRIPTION_WEBHOOK_URL=
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=45
VOICE_TTS_WEBHOOK_URL=
VOICE_TTS_TIMEOUT_SECONDS=30
VOICE_MIN_AUDIO_REPLY_CONFIDENCE=0.72

# Observability / APM
OTEL_EXPORT_ENABLED=false
OTEL_EXPORT_ENDPOINT=
OTEL_SERVICE_NAME=waos-api
OTEL_EXPORT_TIMEOUT_SECONDS=5
DATADOG_OTLP_ENDPOINT=
DATADOG_API_KEY=
DATADOG_SERVICE=waos-api
DATADOG_ENV=production
NEW_RELIC_OTLP_ENDPOINT=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=WAOS
